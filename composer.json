{
  "name": "carwash/service-center",
  "type": "project",
  "description": "Car Wash & Vehicle Service Center Management and Automation System",
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "require": {
    "php": "^8.3",
    "laravel/framework": "^11.0",
    "laravel/tinker": "^2.10",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "setup": ["@php artisan migrate --seed", "@php artisan storage:link"]},
  "minimum-stability": "stable",
  "prefer-stable": true
}
